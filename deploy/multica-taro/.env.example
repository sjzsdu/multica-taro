# Multica 移动端（Taro H5）用户配置
# 本文件复制到 deploy 仓库后进 git，只放用户需要关心的配置；无随机密钥。

# ---------- 镜像 ----------
# 由 multica-taro 仓库 GitHub Actions 构建推送（workflow: Publish Docker image）
MULTICA_TARO_IMAGE=sjzsdu/multica-taro
# 生产建议固定版本号便于回滚（例如 v0.1.0），latest 适合日常迭代
MULTICA_TARO_TAG=latest

# ---------- 对外域名 ----------
# 需要提前在 DNS 添加 A 记录指向服务器（115.159.58.27），
# Traefik 才能签发 Let's Encrypt 证书。
MULTICA_TARO_DOMAIN=m.wnbgj.com

# ---------- API 上游 ----------
# 同一 traefik-public 网络里的 multica 后端容器。
# H5 的 /api /auth /ws 会反代到这里，浏览器全程同源。
MULTICA_TARO_API_UPSTREAM=http://multica-backend:8080

# ---------- 访问控制（可选） ----------
# 逗号分隔的 CIDR，例如 1.2.3.0/24,10.0.0.0/8；留空 = 不启用。
# 启用后只有这些来源可以访问 H5 及其 /api、/auth 反代。
# 家宽/办公出口 IP 会变化，建议先确认固定出口再启用，避免把自己挡在外面。
MULTICA_TARO_ALLOWED_CIDRS=
