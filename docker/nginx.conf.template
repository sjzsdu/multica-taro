# Multica Taro H5 — static host + same-origin API proxy.
#
# Rendered by the nginx image entrypoint (envsubst) from
# /etc/nginx/templates/default.conf.template. Only environment variable names
# are substituted, so nginx runtime variables such as $host stay intact.

server {
    listen 80;
    server_name _;

    # Docker's embedded DNS. Resolving the upstream per request (instead of
    # once at startup) lets nginx boot before multica-backend is up and
    # survives its container being recreated with a new IP.
    # Both directives must live inside `server`: `set` is only allowed in
    # server/location/if, and a conf.d file sits in the http context.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    # Attachments and long descriptions can be sizeable.
    client_max_body_size 50m;

    # Health endpoint for Docker / Traefik probes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Never cache the shell: a new deploy must pick up the new chunk names.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # PWA manifest and worker must revalidate so updates roll out immediately.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header Service-Worker-Allowed "/";
    }

    # Same-origin API. Keeping this on the same host means the Multica backend
    # does not need this domain in CORS_ALLOWED_ORIGINS.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Login and session endpoints live outside /api on the Multica backend.
    location /auth/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Reserved for the realtime channel if the mobile client adopts it later.
    location /ws {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Taro emits stable chunk file names (app.js, 136.js), so JS/CSS must be
    # revalidated instead of cached for days; images and fonts are safe to cache.
    location ~* \.(?:js|css)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location ~* \.(?:png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # Client-side routes (Taro browser router) fall back to the shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
